PORT=3000
APP_NAME=DropImg
APP_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

VITE_APP_NAME=DropImg

DATABASE_URL=file:app.sqlite

# Better Auth
BETTER_AUTH_SECRET=a-very-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

STORAGE_DRIVER=local
UPLOAD_DIR=data/uploads

MAX_UPLOAD_MB=20
ALLOWED_TYPES=image/png,image/jpeg,image/webp,image/gif

# Video uploads (chunked via services/uploader — requires STORAGE_DRIVER=s3)
VIDEO_UPLOADS_ENABLED=true
MAX_VIDEO_UPLOAD_MB=500
VIDEO_TRANSCODE_ENABLED=false
INTERNAL_UPLOAD_SECRET=change-me-to-random-secret
API_INTERNAL_URL=http://dropimg:3000
CHUNK_SIZE_BYTES=8388608

PUBLIC_UPLOADS=false
ADMIN_TOKEN=change-me

# S3 Storage (Optional)
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=dropimg
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=change-me
# S3_SECRET_ACCESS_KEY=change-me
# S3_FORCE_PATH_STYLE=true
